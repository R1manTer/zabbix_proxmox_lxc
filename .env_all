# =============================================================
#  Zabbix 7.0 LTS — Environment Configuration
#  Target: 500 devices | Server RAM: 4GB | Storage: large disk
# =============================================================

# --- PostgreSQL ---
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=zabbix_pwd
POSTGRES_DB=zabbix
POSTGRES_HOST=postgres-server

# --- PostgreSQL tuning (injected via command in compose) ---
PG_SHARED_BUFFERS=512MB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_WAL_BUFFERS=16MB
PG_CHECKPOINT_COMPLETION_TARGET=0.9
PG_MAX_CONNECTIONS=100

# --- Zabbix Server tuning ---
# ICMP Ping processes: sufficient for 500 hosts at 15-20s interval
ZBX_STARTPINGERS=25
# Disable Network Discovery processes to save RAM
ZBX_STARTDISCOVERERS=0

# Reduce unused processes to save RAM
ZBX_STARTPOLLERS=10
ZBX_STARTIPMIPOLLERS=0
ZBX_STARTJAVAPOLLERS=0
ZBX_STARTVMWARECOLLECTORS=0
ZBX_STARTSNMPTRAPPER=0
ZBX_STARTDBSYNCERS=4
ZBX_CACHESIZE=256M
ZBX_HISTORYCACHESIZE=64M
ZBX_HISTORYINDEXCACHESIZE=32M
ZBX_TRENDCACHESIZE=32M
ZBX_VALUECACHESIZE=64M

# Disable Java Gateway & VMware (not used)
ZBX_JAVAGATEWAY_ENABLE=false
ZBX_ENABLE_SNMP_TRAPPER=false

# Housekeeping: history 30 days, trends 730 days
ZBX_HOUSEKEEPINGFREQUENCY=1
ZBX_MAXHOUSEKEEPERDELETE=5000

# --- Zabbix Web (Nginx) ---
PHP_TZ=Europe/Kyiv
ZBX_SERVER_HOST=zabbix-server
ZBX_SERVER_PORT=10051

# --- Agent defaults ---
ZBX_HOSTNAME=Zabbix-Server
ZBX_SERVER_ACTIVE=zabbix-server

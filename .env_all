# =============================================================
#  Zabbix 7.0 LTS — Environment Configuration
#  Production-ready | All fixes applied
# =============================================================

# --- PostgreSQL ---
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=zabbix_pwd
POSTGRES_DB=zabbix
POSTGRES_HOST=postgres-server

# --- Zabbix Server tuning ---
ZBX_STARTPINGERS=25
ZBX_STARTPOLLERS=10
ZBX_STARTIPMIPOLLERS=0
ZBX_STARTJAVAPOLLERS=0
ZBX_STARTVMWARECOLLECTORS=0
ZBX_STARTDBSYNCERS=4
ZBX_CACHESIZE=256M
ZBX_HISTORYCACHESIZE=64M
ZBX_HISTORYINDEXCACHESIZE=32M
ZBX_TRENDCACHESIZE=32M
ZBX_VALUECACHESIZE=64M

# --- Zabbix Web ---
PHP_TZ=Europe/Kyiv
ZBX_SERVER_HOST=zabbix-server
ZBX_SERVER_PORT=10051

# --- Agent ---
# КРИТИЧНО: має точно співпадати з назвою хоста в Zabbix БД
# Перевірити: SELECT host FROM hosts WHERE hostid=10084;
ZBX_HOSTNAME=Zabbix server
ZBX_SERVER_ACTIVE=zabbix-server
